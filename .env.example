# Environment
ENVIRONMENT=development
DEBUG=true

# Market Defaults
DEFAULT_MARKET_NAME=Accra
DEFAULT_MARKET_TIMEZONE=Africa/Accra
DEFAULT_MARKET_CURRENCY=GHS

# Database
DATABASE_URL=postgresql+psycopg://league:league@localhost:5432/league
TEST_DATABASE_URL=postgresql+psycopg://league:league@localhost:5432/league_test

# Auth & Security
SECRET_KEY=change-this-in-production-to-a-secure-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Stripe (Test Mode)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# Client
EXPO_PUBLIC_API_URL=http://localhost:8000

# Logging & Sentry
LOG_LEVEL=info
SENTRY_DSN=
